// Cash Flow Decision OS – Prisma Schema
// PostgreSQL datasource

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ────────────────────────────────────────────────
// COMPANY
// ────────────────────────────────────────────────

model Company {
  id                  String   @id @default(uuid())
  name                String
  clerkOrgId          String?  @unique
  isDemo              Boolean  @default(false)
  onboardingCompleted Boolean  @default(false)
  onboardingStep      Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  notes               CompanyNote[]
  cashSnapshots       CashSnapshot[]
  cashAdjustments     CashAdjustment[]
  customerProfiles    CustomerProfile[]
  vendorProfiles      VendorProfile[]
  receivableInvoices  ReceivableInvoice[]
  payableBills        PayableBill[]
  assumptions         Assumption[]
  bankAccounts        BankAccount[]
  bankTransactions    BankTransaction[]
  recurringPatterns   RecurringPattern[]
  mappingProfiles     MappingProfile[]
  overrides           Override[]
  changeLogs          ChangeLog[]
  forecastWeeks       ForecastWeek[]
  actionItems         ActionItem[]
  scenarioItems       ScenarioItem[]
  stagedImportRows    StagedImportRow[]
  cashFlowCategories  CashFlowCategory[]
  cashFlowEntries     CashFlowEntry[]
  forecastCheckpoints ForecastCheckpoint[]
  baselineVarianceLedgers BaselineVarianceLedger[]
  executionPlans      ExecutionPlan[]
  customerPaymentObservations CustomerPaymentObservation[]
  vendorPaymentObservations   VendorPaymentObservation[]
  importBatches               ImportBatch[]
  importApplications          ImportApplication[]
  importApplyChanges          ImportApplyChange[]
  learningProposals           LearningProposal[]
}

model CompanyNote {
  id        String   @id @default(uuid())
  companyId String
  noteText  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// ────────────────────────────────────────────────
// CASH
// ────────────────────────────────────────────────

model CashSnapshot {
  id          String   @id @default(uuid())
  companyId   String
  asOfDate    DateTime
  bankBalance Float
  createdAt   DateTime @default(now())

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  forecastCheckpoint ForecastCheckpoint?
}

// type: pending_deposit | uncleared_check | restricted_cash | other
model CashAdjustment {
  id            String   @id @default(uuid())
  companyId     String
  type          String
  amount        Float
  effectiveDate DateTime
  note          String?
  createdAt     DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// ────────────────────────────────────────────────
// PROFILES
// ────────────────────────────────────────────────

// riskTag: low | med | high
model CustomerProfile {
  id                String   @id @default(uuid())
  companyId         String
  customerName      String
  typicalDelayWeeks Int?
  riskTag           String   @default("low")
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// criticality: critical | normal
model VendorProfile {
  id          String   @id @default(uuid())
  companyId   String
  vendorName  String
  criticality String   @default("normal")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// ────────────────────────────────────────────────
// AR / AP
// ────────────────────────────────────────────────

// status: open | paid | void
model ReceivableInvoice {
  id           String    @id @default(uuid())
  companyId    String
  customerName String
  invoiceNo    String
  invoiceDate  DateTime?
  dueDate      DateTime?
  amountOpen   Float
  daysPastDue  Int?
  status       String    @default("open")
  metaJson     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// status: open | paid | void
model PayableBill {
  id          String    @id @default(uuid())
  companyId   String
  vendorName  String
  billNo      String
  billDate    DateTime?
  dueDate     DateTime?
  amountOpen  Float
  daysPastDue Int?
  status      String    @default("open")
  metaJson    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// ────────────────────────────────────────────────
// ASSUMPTIONS
// ────────────────────────────────────────────────

// payrollCadence: weekly | biweekly
model Assumption {
  id                     String    @id @default(uuid())
  companyId              String
  bufferMin              Float     @default(10000)
  fixedWeeklyOutflow     Float     @default(0)
  payrollCadence         String    @default("biweekly")
  payrollAllInAmount     Float?
  payrollNextDate        DateTime?
  rentMonthlyAmount      Float?
  rentDayOfMonth         Int?
  paymentCurveJson       String    @default("{\"current\":0,\"1-14\":1,\"15-30\":2,\"31-60\":3,\"61+\":4}")
  highRiskAgingDays      Int       @default(61)
  projectionSafetyMargin Float     @default(1.0)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// ────────────────────────────────────────────────
// BANK DATA (optional)
// ────────────────────────────────────────────────

model BankAccount {
  id        String   @id @default(uuid())
  companyId String
  name      String?
  createdAt DateTime @default(now())

  company      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transactions BankTransaction[]
}

// direction: inflow | outflow
model BankTransaction {
  id          String   @id @default(uuid())
  companyId   String
  accountId   String?
  txDate      DateTime
  amount      Float
  description String
  direction   String
  txHash      String?
  createdAt   DateTime @default(now())

  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  account BankAccount? @relation(fields: [accountId], references: [id])

  @@unique([companyId, txHash])
}

// ────────────────────────────────────────────────
// RECURRING / BASELINE
// ────────────────────────────────────────────────

// direction: inflow | outflow
// cadence: weekly | biweekly | monthly | irregular
// confidence: high | med | low
// category: payroll | rent | loan | subscription | utilities | fuel | materials | taxes | card_payment | other
model RecurringPattern {
  id               String    @id @default(uuid())
  companyId        String
  direction        String
  merchantKey      String
  displayName      String
  typicalAmount    Float
  amountStdDev     Float     @default(0)
  cadence          String
  nextExpectedDate DateTime?
  confidence       String    @default("med")
  category         String    @default("other")
  isIncluded       Boolean   @default(true)
  isCritical       Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// ────────────────────────────────────────────────
// MAPPINGS
// ────────────────────────────────────────────────

// kind: ar | ap | bank
model MappingProfile {
  id          String   @id @default(uuid())
  companyId   String
  kind        String
  mappingJson String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, kind])
}

// ────────────────────────────────────────────────
// OVERRIDES + AUDIT
// ────────────────────────────────────────────────

// type: partial_payment | mark_paid | delay_due_date | adjust_amount |
//       add_one_time_outflow | add_one_time_inflow |
//       set_expected_payment_date | set_bill_due_date |
//       set_customer_delay | set_vendor_criticality |
//       set_recurring_pattern | toggle_recurring_included |
//       set_payroll | set_rent | set_fixed_outflow | add_cash_adjustment
// targetType: invoice | bill | assumption | cash | customer | vendor | recurring
// status: active | orphaned | archived
model Override {
  id            String    @id @default(uuid())
  companyId     String
  type          String
  targetType    String
  targetId      String?
  amount        Float?
  effectiveDate DateTime?
  metaJson      String?
  status        String    @default("active")
  createdAt     DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// source: user_ui | command_box | system
// diffJson contains: { targetId, targetType, entityType, entityId, fieldChanged,
//   oldValue, newValue, reasoning, reason, approvedPlanVersion, source }
model ChangeLog {
  id                        String   @id @default(uuid())
  companyId                 String
  timestamp                 DateTime @default(now())
  source                    String
  action                    String
  inputText                 String?
  diffJson                  String
  forecastVersionHashBefore String?
  forecastVersionHashAfter  String
  userId                    String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// ────────────────────────────────────────────────
// FORECAST OUTPUT
// ────────────────────────────────────────────────

// zone: committed | pattern | uncertain
model ForecastWeek {
  id                  String   @id @default(uuid())
  companyId           String
  weekStart           DateTime
  weekEnd             DateTime
  startCash           Float
  inflowsExpected     Float
  outflowsExpected    Float
  endCashExpected     Float
  inflowsBest         Float
  outflowsBest        Float
  endCashBest         Float
  inflowsWorst        Float
  outflowsWorst       Float
  endCashWorst        Float
  zone                String
  confidenceScore     Int      @default(100)
  breakdownJson       String?
  computedAt          DateTime @default(now())
  forecastVersionHash String

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, weekStart, forecastVersionHash])
}

// ────────────────────────────────────────────────
// ACTIONS
// ────────────────────────────────────────────────

// type: collect_ar | delay_ap | reduce_outflows | add_cash_adjustment | other | risk_alert
// priority: p1 | p2 | p3
// impactCertainty: high | med | low
// targetType: invoice | bill | assumption | cash | customer | vendor | recurring
model ActionItem {
  id                  String    @id @default(uuid())
  companyId           String
  type                String
  priority            String
  title               String
  description         String
  // Convention for amountImpact:
  // Positive = cash increase (e.g. AR collection, AP deferral, manual inflow)
  // Negative = cash decrease (e.g. AP payment, AR deferral, manual outflow)
  amountImpact        Float
  actualAmountImpact  Float?
  impactCertainty     String
  constraintWeekStart DateTime?
  targetType          String
  targetId            String?
  reasoningJson       String
  createdAt           DateTime  @default(now())

  executionPlanId     String?
  ownerName           String?
  dueDate             DateTime?
  status              String    @default("planned")
  completedAt         DateTime?
  completionNote      String?

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  executionPlan ExecutionPlan? @relation(fields: [executionPlanId], references: [id], onDelete: SetNull)

  @@index([executionPlanId])
  @@index([companyId, status])
}

// ────────────────────────────────────────────────
// SCENARIO / WHAT-IF
// ────────────────────────────────────────────────

// direction: in | out
model ScenarioItem {
  id         String   @id @default(uuid())
  companyId  String
  label      String
  direction  String // "in" | "out"
  weekNumber Int
  amount     Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// ────────────────────────────────────────────────
// CASH FLOW CATEGORIES (custom in/out)
// ────────────────────────────────────────────────

// direction: inflow | outflow
model CashFlowCategory {
  id        String   @id @default(uuid())
  companyId String
  name      String
  direction String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  entries CashFlowEntry[]

  @@unique([companyId, name, direction])
}

model CashFlowEntry {
  id         String   @id @default(uuid())
  companyId  String
  categoryId String
  label      String
  amount     Float
  targetDate DateTime @default(now())
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category CashFlowCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

// ────────────────────────────────────────────────
// FORECAST MEMORY / CHECKPOINT
// ────────────────────────────────────────────────

model ForecastCheckpoint {
  id                  String    @id @default(uuid())
  companyId           String
  cashSnapshotId      String    @unique
  snapshotSource      String    @default("client_observed_v1")
  forecastVersionHash String?
  generatedAt         DateTime?
  weekStart           DateTime
  weekEnd             DateTime
  endCashExpected     Float
  inflowsExpected     Float
  outflowsExpected    Float
  breakdownJson       String?
  createdAt           DateTime  @default(now())

  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cashSnapshot CashSnapshot @relation(fields: [cashSnapshotId], references: [id], onDelete: Cascade)
}

// ────────────────────────────────────────────────
// MACRO-MEMORY / BASELINE VARIANCE
// ────────────────────────────────────────────────

model BaselineVarianceLedger {
  id               String   @id @default(uuid())
  companyId        String
  weekStart        DateTime // The week that was predicted
  projectedOutflow Float    // What the baseline math said would happen
  actualOutflow    Float    // What actually happened in the bank (excluding recurring)
  variancePct      Float    // (Actual - Projected) / Projected

  // [NEW] Inflow Tracking
  projectedInflow  Float?
  actualInflow     Float?
  variancePctIn    Float?

  createdAt        DateTime @default(now())

  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, weekStart])
}

// ────────────────────────────────────────────────
// EXECUTION PLAN (WEEKLY PLAN)
// ────────────────────────────────────────────────

// status: approved | superseded | executed
model ExecutionPlan {
  id                 String   @id @default(uuid())
  companyId          String
  weekStart          DateTime
  version            Int      @default(1)
  status             String   @default("approved")
  supersededAt       DateTime?
  supersededByPlanId String?
  createdAt          DateTime @default(now())

  approvedBy         String?
  revisionReason     String?
  forecastStateJson  String?

  reviewedAt         DateTime?
  actualEndingCash   Float?

  actionItems        ActionItem[]

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, weekStart])
}

// ────────────────────────────────────────────────
// MEMORY HARDENING – PAYMENT BEHAVIOR
// ────────────────────────────────────────────────

// Append-only record of a verified customer payment event.
// An observation is only written when payment is confirmed from an authoritative source.
// paymentSource: ar_import | bank_match | manual_verified
// Do NOT write an observation for a manually-moved expected date.
model CustomerPaymentObservation {
  id                  String    @id @default(uuid())
  companyId           String
  customerName        String
  invoiceId           String?   // FK to ReceivableInvoice (optional, for joins)
  invoiceNo           String?
  dueDate             DateTime?
  expectedPaymentDate DateTime? // Set at the time of import / override
  actualPaymentDate   DateTime  // The verified actual payment date
  daysEarlyOrLate     Int       // Negative = early, positive = late (vs dueDate)
  amount              Float
  paymentSource       String    // ar_import | bank_match | manual_verified
  observedAt          DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Prevent duplicate observations for the same invoice payment
  @@unique([companyId, invoiceId, actualPaymentDate])
  @@index([companyId, customerName])
}

// Append-only record of a verified vendor payment event.
// paymentSource: ap_import | bank_match | manual_verified
model VendorPaymentObservation {
  id                 String    @id @default(uuid())
  companyId          String
  vendorName         String
  billId             String?   // FK to PayableBill (optional)
  billNo             String?
  dueDate            DateTime?
  plannedPaymentDate DateTime? // When we planned to pay it
  actualPaymentDate  DateTime  // The verified actual payment date
  daysEarlyOrLate    Int       // Negative = early, positive = late (vs dueDate)
  amount             Float
  paymentSource      String    // ap_import | bank_match | manual_verified
  observedAt         DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Prevent duplicate observations for the same bill payment
  @@unique([companyId, billId, actualPaymentDate])
  @@index([companyId, vendorName])
}

// ────────────────────────────────────────────────
// MEMORY HARDENING – IMPORT BATCH TRACKING
// ────────────────────────────────────────────────

// importType: ar | ap | bank
// status: success | partial | failed
model ImportBatch {
  id               String    @id @default(uuid())
  companyId        String
  importType       String    // ar | ap | bank
  filename         String
  uploadedBy       String?   // Clerk user ID if available
  uploadedAt       DateTime  @default(now())
  rowCount         Int
  acceptedCount    Int       @default(0)
  rejectedCount    Int       @default(0)
  duplicateCount   Int       @default(0)
  status           String    @default("success") // success | partial | failed
  sourceDateStart  DateTime? // Earliest date in the imported data
  sourceDateEnd    DateTime? // Latest date in the imported data
  fileHash         String?   // SHA-256 of file bytes, for dedup detection
  mappingProfileId String?   // FK to MappingProfile
  errorSummary     String?   // JSON array of error messages

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stagedRows       StagedImportRow[]
  application      ImportApplication?

  @@index([companyId, importType])
}

// ────────────────────────────────────────────────
// SAFE DATA SOURCES – STAGED IMPORTS
// ────────────────────────────────────────────────

model StagedImportRow {
  id                   String   @id @default(uuid())
  companyId            String
  importBatchId        String
  importType           String   // ar | ap | bank
  sourceRowNumber      Int
  rawDataJson          String   // JSON string of the raw row
  normalizedDataJson   String   // JSON string of the normalized parsed row
  validationStatus     String   // valid | invalid
  validationErrorsJson String?  // JSON array of error strings
  conflictType         String   // new | exact_duplicate | changed_existing | possible_match | possible_duplicate | invalid
  matchedRecordId      String?
  fieldDifferencesJson String?  // JSON array of differences
  proposedAction       String   // insert | update | skip | review

  userDecision         String?  // accept_insert | accept_update | keep_existing | treat_as_new | skip | link_and_review
  linkedRecordId       String?  // ID of the user-selected live record to link (e.g. for possible_match)
  reviewedBy           String?
  reviewedAt           DateTime?
  reviewNote           String?

  rollbackStatus       String?  // rolled_back | blocked
  rollbackError        String?

  applyStatus          String?  // inserted | updated | skipped | failed
  appliedRecordId      String?
  appliedAt            DateTime?
  applyError           String?
  createdAt            DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  batch   ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  @@index([companyId, importBatchId])
}

model ImportApplication {
  id                 String   @id @default(cuid())
  companyId          String
  importBatchId      String   @unique
  importType         String
  appliedBy          String?
  appliedAt          DateTime @default(now())
  status             String   @default("applied") // applied | rolled_back
  rolledBackAt       DateTime?
  rolledBackBy       String?
  forecastHashBeforeRollback String?
  forecastHashAfterRollback  String?
  rollbackEnrichmentError    String?

  insertedCount      Int      @default(0)
  updatedCount       Int      @default(0)
  skippedCount       Int      @default(0)
  failedCount        Int      @default(0)
  forecastHashBefore String?
  forecastHashAfter  String?
  enrichmentError    String?
  changeLogId        String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  batch   ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  changes ImportApplyChange[]
}

model ImportApplyChange {
  id                  String   @id @default(uuid())
  companyId           String
  importApplicationId String
  stagedRowId         String
  entityType          String   // ar | ap | bank
  entityId            String
  operation           String   // insert | update
  beforeJson          String?  // JSON
  afterJson           String   // JSON
  changedFieldsJson   String   // JSON containing keys that were modified by this application and their before/after values
  createdAt           DateTime @default(now())

  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  application ImportApplication @relation(fields: [importApplicationId], references: [id], onDelete: Cascade)

  @@index([companyId, importApplicationId])
}

// ────────────────────────────────────────────────
// LEARNING / PROPOSALS
// ────────────────────────────────────────────────

model LearningProposal {
  id                 String    @id @default(uuid())
  companyId          String
  type               String
  proposedChangeJson String
  rationale          String
  evidenceActionIds  String    // JSON array
  status             String    @default("pending") // pending | approved | rejected
  createdAt          DateTime  @default(now())
  reviewedAt         DateTime?
  reviewedBy         String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
}
